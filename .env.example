# Arc Testnet
NEXT_PUBLIC_ARC_TESTNET_RPC=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_GATEWAY_WALLET=0x0077777d7EBA4688BDeF3E311b846F25870A19B9

# Deployed vault. Filled after `forge script` on Arc Testnet 5042002.
NEXT_PUBLIC_VAULT_ADDRESS=0xcA9F8D931b6a0dE64ED74757A66aCB203413f2C1
NEXT_PUBLIC_USYC_ADDRESS=0xe9185f0c5f296ed1797aae4238d26ccabeadb86c

# WalletConnect Cloud project id. Public client id, required to open the connect modal.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Signs gateway x402 receipts and recordUsage. Must be the vault owner. Never commit the value.
AGENT_SIGNER_PRIVATE_KEY=

# LLM Keys (at least one provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Supabase (Optional - dual-mode persistence)
# If not set, uses in-memory store (dev-friendly)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
